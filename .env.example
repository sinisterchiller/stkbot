# Discord bot token from Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional. No value is needed: the bot registers /price in every server it is
# in (and every server it joins later) automatically. Setting a server (guild)
# ID additionally registers that one server before the gateway connects.
# Existing global command registrations are never deleted.
# DISCORD_GUILD_ID=123456789012345678
